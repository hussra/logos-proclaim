{
  "name": "@hussra/logos-proclaim",
  "version": "1.1.1",
  "description": "Node module to communicate with Logos Proclaim through its App Command and Remote APIs",
  "keywords": [
    "logos",
    "proclaim",
    "faithlife"
  ],
  "homepage": "https://github.com/hussra/logos-proclaim",
  "bugs": "https://github.com/hussra/logos-proclaim/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hussra/logos-proclaim.git"
  },
  "license": "MIT",
  "author": {
    "name": "Richard Huss",
    "email": "richard@huss.org.uk"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "prepare": "husky",
    "prepack": "yarn build",
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "lint": "eslint ."
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "type": "module",
  "main": "dist/proclaim-api.js",
  "types": "dist/proclaim-api.d.ts",
  "dependencies": {
    "emittery": "^2.2.0",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "files": [
    "dist/"
  ]
}
